// Yaya OS webcam-dashboard banner, short-pane variant (~12 lines).
// yaya-webcam switches to this when the banner pane can't fit webcam.jsonc.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/yaya/fastfetch/yaya-logo-small.txt",
    "color": { "1": "38;5;79" },
    "padding": { "top": 0, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;5;79", "title": "38;5;79" }
  },
  "modules": [
    { "type": "custom", "format": "\u001b[38;5;79m Y A Y A   O S\u001b[0m" },
    // Values are trimmed to bare names: this variant runs in narrow panes, and a
    // wrapped line pushes the logo apart and scrolls the header off the top.
    { "type": "os", "key": " os ", "format": "{2} {9}" },
    { "type": "kernel", "key": " kernel ", "format": "{2}" },
    { "type": "cpu", "key": " cpu ", "format": "{1}" },
    { "type": "memory", "key": " memory " },
    "break",
    {
      "type": "command",
      "key": " camera ",
      "text": "gphoto2 --auto-detect 2>/dev/null | awk -v pat=\"${YAYA_CAM_MATCH:-Canon}\" 'NR>2 && $0 ~ pat {f=1; sub(/[ \\t]+usb:.*/,\"\"); print; exit} END{if(!f) print \"no \" pat \" attached\"}'; true"
    },
    {
      "type": "command",
      "key": " sink ",
      "text": "if [ -e /dev/video42 ]; then echo '/dev/video42  ready'; else echo '/dev/video42  not loaded'; fi"
    },
    {
      "type": "command",
      "key": " encoder ",
      "text": "pgrep -x ffmpeg >/dev/null && echo 'ffmpeg  running' || echo 'ffmpeg  stopped'"
    }
  ]
}
