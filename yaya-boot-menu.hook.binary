#!/bin/sh
# ============================================================
# Yaya OS — binary hook: menús de arranque de la ISO (v2)
#   · GRUB (UEFI): default=Instalar (LUKS), colores magenta,
#     entrada "Live persistente"
#   · isolinux (BIOS): entrada Instalar preseeded (default) +
#     "Live persistente"  [FIX: BIOS no tenía install guiado]
#   · /YAYA_VERSION en la raíz de la ISO
# OJO: live-build ejecuta los hooks binary con CWD=binary/.
# ============================================================
set -e

YAYA_VERSION="2.0"
BUILD_STAMP="$(date -u +%Y%m%d-%H%M)"

# --- Resolver rutas (CWD puede ser binary/ o la raíz del build) ---
if [ -d binary ]; then BIN=binary; CFG=config; else BIN=.; CFG=../config; fi

# --- Version file en la raíz de la ISO -----------------------
echo "Yaya OS ${YAYA_VERSION} build ${BUILD_STAMP} UTC" > "$BIN/YAYA_VERSION"

# --- Boot append de live (para construir la entrada persistente)
LB_BOOTAPPEND_LIVE=""
[ -f "$CFG/binary" ] && . "$CFG/binary"
K=$(cd "$BIN/live" && ls vmlinuz-* 2>/dev/null | head -1 || true)
I=$(cd "$BIN/live" && ls initrd.img-* 2>/dev/null | head -1 || true)

# ================= GRUB (UEFI) ================================
G="$BIN/boot/grub/grub.cfg"
if [ -f "$G" ] && ! grep -q 'Instalar Yaya OS' "$G"; then
  {
    cat <<'BLK'
set default=0
set timeout=20
set color_normal=magenta/black
set color_highlight=white/magenta
set menu_color_normal=magenta/black
set menu_color_highlight=white/magenta

menuentry "Instalar Yaya OS  --  disco completo, cifrado (LUKS)" --hotkey=i {
	set gfxpayload=keep
	linux	/install/gtk/vmlinuz auto=true priority=high preseed/file=/cdrom/preseed.cfg vga=788 --- quiet splash
	initrd	/install/gtk/initrd.gz
}
BLK
    if [ -n "$K" ]; then
      printf 'menuentry "Live persistente  --  guarda cambios en el USB" --hotkey=p {\n'
      printf '\tlinux\t/live/%s %s persistence findiso=${iso_path}\n' "$K" "$LB_BOOTAPPEND_LIVE"
      printf '\tinitrd\t/live/%s\n}\n' "$I"
    fi
  } > /tmp/yaya_grub_insert

  awk '
    /^source \/boot\/grub\/config.cfg/ {
      print
      while ((getline line < "/tmp/yaya_grub_insert") > 0) print line
      close("/tmp/yaya_grub_insert")
      next
    }
    { print }
  ' "$G" > "$G.new" && mv "$G.new" "$G"
  rm -f /tmp/yaya_grub_insert
  echo "yaya: grub.cfg parcheado (Instalar default + Live persistente)"
fi

# ================= isolinux (BIOS) ============================
L="$BIN/isolinux/live.cfg"
if [ -f "$L" ]; then
  if ! grep -q 'live-amd64-persistence' "$L"; then
    {
      printf '\nlabel live-amd64-persistence\n'
      printf '\tmenu label Live persistente (guarda cambios en el USB)\n'
      printf '\tlinux /live/vmlinuz\n\tinitrd /live/initrd.img\n'
      printf '\tappend %s persistence\n' "$LB_BOOTAPPEND_LIVE"
    } >> "$L"
    echo "yaya: isolinux live.cfg parcheado (persistencia)"
  fi
fi

C="$BIN/isolinux/install.cfg"
if [ -f "$C" ] && ! grep -q 'label installyaya' "$C"; then
  sed -i 's/^\tmenu default$//' "$L" 2>/dev/null || true
  TMPI=$(mktemp)
  {
    printf 'label installyaya\n'
    printf '\tmenu label Instalar Yaya OS -- disco completo, cifrado (LUKS)\n'
    printf '\tmenu default\n'
    printf '\tlinux /install/gtk/vmlinuz\n\tinitrd /install/gtk/initrd.gz\n'
    printf '\tappend auto=true priority=high preseed/file=/cdrom/preseed.cfg vga=788 --- quiet splash\n\n'
  } > "$TMPI"
  cat "$C" >> "$TMPI" && mv "$TMPI" "$C"
  echo "yaya: isolinux install.cfg parcheado (Instalar preseeded default)"
fi
