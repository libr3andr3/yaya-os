# Yaya OS — "daily driver" app set for non-technical users (GNOME edition).
# Installed via live-build package list (config/package-lists/yaya-desktop.list.chroot).
# The desktop itself (GNOME Shell, GDM, Files, Console, Software, Settings,
# Document Viewer, Image Viewer, Calculator, Disks, System Monitor…) comes
# from gnome-core, installed by setup-yaya-gnome.sh.
#
# Keep this list to packages that exist in Debian stable: a missing name here
# fails the whole live-build. Anything uncertain goes in the tolerant loop in
# setup-yaya-gnome.sh instead.

# --- Office & documents ---
libreoffice-writer
libreoffice-calc
libreoffice-impress
libreoffice-gtk3
libreoffice-l10n-es
hunspell-en-us
hunspell-es

# --- Photos, video, music, camera ---
vlc
cheese
gstreamer1.0-plugins-good
gstreamer1.0-plugins-bad
gstreamer1.0-plugins-ugly
gstreamer1.0-libav
libavcodec-extra

# --- Email ---
thunderbird
thunderbird-l10n-es-es

# --- Printing & scanning ---
cups
cups-browsed
ipp-usb
printer-driver-gutenprint
hplip
simple-scan
sane-airscan

# --- Hardware / laptop ---
power-profiles-daemon
ntfs-3g
exfatprogs
fwupd
systemd-timesyncd

# --- Software store & updates ---
flatpak
gnome-software-plugin-flatpak
unattended-upgrades

# --- Fonts ---
fonts-noto-core
fonts-noto-color-emoji
fonts-liberation2
fonts-crosextra-carlito
fonts-crosextra-caladea

# --- System utilities ---
file-roller
unzip
zip
