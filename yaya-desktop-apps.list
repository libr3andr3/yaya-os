# Yaya OS — "daily driver" app set for non-technical users (KDE Plasma edition).
# Installed via live-build package list (config/package-lists/yaya-desktop.list.chroot).
# Desktop core apps (Dolphin, Konsole, Kate, Okular, Gwenview, Ark, KCalc,
# Spectacle, Discover, Filelight, System Monitor, Partition Manager,
# Print Manager) are installed by setup-yaya-plasma.sh.

# --- Office & documents ---
libreoffice-writer
libreoffice-calc
libreoffice-impress
libreoffice-kf6
libreoffice-l10n-es
hunspell-en-us
hunspell-es

# --- Photos, video, music, camera ---
vlc
kamoso
gstreamer1.0-plugins-good
gstreamer1.0-plugins-bad
gstreamer1.0-plugins-ugly
gstreamer1.0-libav
libavcodec-extra

# --- Email ---
thunderbird
thunderbird-l10n-es-es

# --- Printing & scanning ---
cups
cups-browsed
ipp-usb
printer-driver-gutenprint
hplip
skanpage
sane-airscan

# --- Hardware / laptop ---
power-profiles-daemon
ntfs-3g
exfatprogs
fwupd
systemd-timesyncd

# --- Software store & updates ---
flatpak
unattended-upgrades

# --- Fonts ---
fonts-noto-core
fonts-noto-color-emoji
fonts-liberation2
fonts-crosextra-carlito
fonts-crosextra-caladea

# --- System utilities ---
unzip
zip
