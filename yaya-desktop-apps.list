# Yaya OS — "daily driver" app set for non-technical users (KDE Plasma edition).
# Installed via live-build package list (config/package-lists/yaya-desktop.list.chroot).
# Desktop core apps (Dolphin, Konsole, Kate, Okular, Gwenview, Ark, KCalc,
# Spectacle, Discover, Filelight, System Monitor, Partition Manager,
# Print Manager) are installed by setup-yaya-plasma.sh.

# --- Office & documents ---
libreoffice-writer
libreoffice-calc
libreoffice-impress
libreoffice-kf6
libreoffice-l10n-es
hunspell-en-us
hunspell-es

# --- Photos, video, music, camera ---
vlc
kamoso
# scheduling realtime para PipeWire (Recommends de pipewire-bin; sin él,
# audio con cortes en CPUs viejas)
rtkit
gstreamer1.0-plugins-good
gstreamer1.0-plugins-bad
gstreamer1.0-plugins-ugly
gstreamer1.0-libav
libavcodec-extra
# codecs por hardware (Intel/AMD refurbished: decode H.264/H.265 sin fundir CPU)
gstreamer1.0-vaapi
intel-media-va-driver-non-free
# Intel Gen7 y anteriores (Bay Trail/Haswell — los Atom ASUS de la flota)
i965-va-driver
mesa-va-drivers
# cámara/screencast vía PipeWire (Kamoso, compartir pantalla en Wayland)
gstreamer1.0-pipewire
# fotos de iPhone (HEIC) y WebP en apps GTK (Xournal++, Firefox)
heif-gdk-pixbuf
heif-thumbnailer
webp-pixbuf-loader
# WebP/TIFF/ICNS en apps Qt (Gwenview); HEIC en Gwenview NO tiene paquete
# en trixie (falta kimageformats KF6) — limitación conocida
qt6-image-formats-plugins
# cámaras digitales (PTP) en Dolphin/Gwenview
kamera

# --- Email ---
thunderbird
thunderbird-l10n-es-es

# --- Printing & scanning ---
# descubrimiento de impresoras/escáneres de red (AirPrint/IPP Everywhere)
# y nombres .local: cups-browsed y sane-airscan solo traen las libs de
# avahi, el daemon es Recommends y con --no-install-recommends no entra
avahi-daemon
libnss-mdns
cups
cups-browsed
ipp-usb
printer-driver-gutenprint
printer-driver-escpr
printer-driver-brlaser
hplip
skanpage
sane-airscan

# --- Hardware / laptop ---
# base regulatoria wifi (nada la arrastra como Depends; sin ella el kernel
# capa canales 5GHz y potencia al dominio mundial)
wireless-regdb
# docks/monitores Thunderbolt (ThinkPads de la flota): autorización de
# dispositivos vía bolt + UI en Preferencias
bolt
plasma-thunderbolt
power-profiles-daemon
ntfs-3g
exfatprogs
fwupd
systemd-timesyncd
# montaje de discos/USB/CD (Solid/Dolphin y udisksctl)
udisks2
# monitor de volúmenes + montaje para apps GTK (diálogo de guardar de
# Xournal++/Firefox: sin gvfs no ven ni montan discos externos)
gvfs
gvfs-backends
gvfs-fuse

# --- Software store & updates ---
flatpak
unattended-upgrades

# --- Fonts ---
fonts-noto-core
fonts-noto-color-emoji
fonts-liberation2
fonts-crosextra-carlito
fonts-crosextra-caladea

# --- System utilities ---
# xdg-open (Recommends en toda la pila; scripts y apps no-KDE lo usan
# para abrir archivos/URLs)
xdg-utils
unzip
zip
# .7z y .rar (Ark los abre con estos instalados)
7zip
unrar-free
