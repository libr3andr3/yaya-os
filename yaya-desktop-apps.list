# Yaya OS — "daily driver" app set for non-technical users (GNOME edition).
# Installed via live-build package list (config/package-lists/yaya-desktop.list.chroot).
# Desktop core apps (Nautilus, Console, Text Editor, Evince, Loupe, File Roller,
# Calculator, Software, Baobab, System Monitor, Disks, GParted) are installed
# by setup-yaya-gnome.sh.

# --- Office & documents ---
libreoffice-writer
libreoffice-calc
libreoffice-impress
libreoffice-gtk3
libreoffice-l10n-es
hunspell-en-us
hunspell-es
gnome-calendar

# --- Photos, video, music, camera ---
vlc
gnome-snapshot
gstreamer1.0-plugins-good
gstreamer1.0-plugins-bad
gstreamer1.0-plugins-ugly
gstreamer1.0-libav
libavcodec-extra
# codecs por hardware (Intel/AMD refurbished: decode H.264/H.265 sin fundir CPU)
gstreamer1.0-vaapi
intel-media-va-driver-non-free
mesa-va-drivers
# cámara/screencast vía PipeWire (Snapshot, compartir pantalla en Wayland)
gstreamer1.0-pipewire
# fotos de iPhone (HEIC) y WebP en Loupe/Nautilus
heif-gdk-pixbuf
heif-thumbnailer
webp-pixbuf-loader

# --- Email ---
thunderbird
thunderbird-l10n-es-es

# --- Printing & scanning ---
cups
cups-browsed
ipp-usb
printer-driver-gutenprint
printer-driver-escpr
printer-driver-brlaser
hplip
simple-scan
sane-airscan

# --- Hardware / laptop ---
power-profiles-daemon
ntfs-3g
exfatprogs
fwupd
systemd-timesyncd
# teléfonos Android (MTP), cámaras y shares de red en Nautilus
gvfs-backends
gvfs-fuse
# montaje de discos/USB/CD (udisksctl + sidebar de Files)
udisks2

# --- Software store & updates ---
flatpak
unattended-upgrades

# --- Fonts ---
fonts-noto-core
fonts-noto-color-emoji
fonts-liberation2
fonts-crosextra-carlito
fonts-crosextra-caladea

# --- System utilities ---
unzip
zip
# .7z y .rar (File Roller los abre con estos instalados)
7zip
unrar-free
