# Yaya OS — "daily driver" app set for non-technical users (GNOME edition).
# Installed via live-build package list (config/package-lists/yaya-desktop.list.chroot).
# Desktop core apps (Nautilus, Console, Text Editor, Evince, Loupe, File Roller,
# Calculator, Software, Baobab, System Monitor, Disks, GParted) are installed
# by setup-yaya-gnome.sh.

# --- Office & documents ---
libreoffice-writer
libreoffice-calc
libreoffice-impress
libreoffice-gtk3
libreoffice-l10n-es
hunspell-en-us
hunspell-es

# --- Photos, video, music, camera ---
vlc
gnome-snapshot
gstreamer1.0-plugins-good
gstreamer1.0-plugins-bad
gstreamer1.0-plugins-ugly
gstreamer1.0-libav
libavcodec-extra

# --- Email ---
thunderbird
thunderbird-l10n-es-es

# --- Printing & scanning ---
cups
cups-browsed
ipp-usb
printer-driver-gutenprint
hplip
simple-scan
sane-airscan

# --- Hardware / laptop ---
power-profiles-daemon
ntfs-3g
exfatprogs
fwupd
systemd-timesyncd

# --- Software store & updates ---
flatpak
unattended-upgrades

# --- Fonts ---
fonts-noto-core
fonts-noto-color-emoji
fonts-liberation2
fonts-crosextra-carlito
fonts-crosextra-caladea

# --- System utilities ---
unzip
zip
