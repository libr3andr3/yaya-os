#!/bin/sh
# ============================================================
# Yaya OS — FIX crítico: live-installer purga del sistema
# instalado todo lo listado en filesystem.packages-remove.
# live-build mete ahí TODO lo instalado por hooks (xfce, xorg,
# lightdm, brave...) porque el snapshot "install" se toma antes
# de los hooks. Dejamos solo los paquetes genuinamente live-only.
# OJO: live-build ejecuta los hooks binary con CWD=binary/.
# ============================================================
set -e
if [ -d binary ]; then BIN=binary; else BIN=.; fi
F="$BIN/live/filesystem.packages-remove"
[ -f "$F" ] || { echo "yaya: sin $F, salto"; exit 0; }
BEFORE=$(wc -l < "$F")
grep -E '^live-(boot|config|tools)' "$F" > "$F.new" || true
mv "$F.new" "$F"
AFTER=$(wc -l < "$F")
echo "yaya: filesystem.packages-remove filtrado: $BEFORE -> $AFTER paquetes"
