#!/bin/sh
# ============================================================
# Yaya OS — FIX mouse en el instalador gráfico:
# el initrd de d-i trae i2c-hid/psmouse/rmi_core pero NO los
# drivers de bus i2c/SMBus (i2c-i801, i2c-smbus, rmi_smbus,
# elan_i2c, synaptics_i2c, i2c-designware-pci). En touchpads
# modernos (Synaptics SMBus / ELAN i2c) el puntero queda muerto.
# Inyecta los .ko del kernel EXACTO de d-i y regenera modules.dep.
# ============================================================
set -e
if [ -d binary ]; then BIN=binary; else BIN=.; fi
IR="$BIN/install/gtk/initrd.gz"
[ -f "$IR" ] || { echo "yaya: no hay initrd gtk, salto"; exit 0; }
IRABS=$(readlink -f "$IR")
MIRROR="http://deb.debian.org/debian"

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
mkdir "$TMP/ir"
( cd "$TMP/ir" && zcat "$IRABS" | cpio -idm --quiet )

MODBASE=""
for d in usr/lib/modules lib/modules; do
  [ -d "$TMP/ir/$d" ] && { MODBASE="$d"; break; }
done
[ -n "$MODBASE" ] || { echo "yaya: initrd sin modules dir?"; exit 1; }
KVER=$(ls "$TMP/ir/$MODBASE" | head -1)
echo "yaya: kernel de d-i = $KVER"

if [ -f "$TMP/ir/$MODBASE/$KVER/kernel/drivers/i2c/busses/i2c-i801.ko.xz" ]; then
  echo "yaya: i2c-i801 ya presente, nada que hacer"; exit 0
fi

# localizar el .deb linux-image exacto en el mirror
PKGSGZ="$TMP/Packages.xz"
FN=""
for suite in trixie trixie-updates trixie-proposed-updates; do
  curl -fsS "$MIRROR/dists/$suite/main/binary-amd64/Packages.xz" -o "$PKGSGZ" || continue
  FN=$(xzcat "$PKGSGZ" | awk -v p="Package: linux-image-$KVER" '
        $0==p {f=1} f && /^Filename:/ {print $2; exit} f && /^$/ {f=0}')
  [ -n "$FN" ] && break
done
[ -n "$FN" ] || { echo "yaya: ERROR no encontré linux-image-$KVER en el mirror"; exit 1; }
echo "yaya: bajando $FN"
curl -fsS "$MIRROR/$FN" -o "$TMP/kern.deb"
dpkg-deb -x "$TMP/kern.deb" "$TMP/kx"

SRC=$(find "$TMP/kx" -maxdepth 4 -type d -name "$KVER" | head -1)
[ -n "$SRC" ] || { echo "yaya: ERROR deb sin modules/$KVER"; exit 1; }

ADDED=0
for m in \
  kernel/drivers/i2c/busses/i2c-i801.ko.xz \
  kernel/drivers/i2c/busses/i2c-piix4.ko.xz \
  kernel/drivers/i2c/busses/i2c-designware-pci.ko.xz \
  kernel/drivers/i2c/busses/i2c-amd-mp2-pci.ko.xz \
  kernel/drivers/i2c/busses/i2c-amd-mp2-plat.ko.xz \
  kernel/drivers/i2c/i2c-smbus.ko.xz \
  kernel/drivers/input/rmi4/rmi_smbus.ko.xz \
  kernel/drivers/input/mouse/elan_i2c.ko.xz \
  kernel/drivers/input/mouse/synaptics_i2c.ko.xz \
  kernel/drivers/platform/x86/i2c-multi-instantiate.ko.xz ; do
  if [ -f "$SRC/$m" ]; then
    install -D -m 644 "$SRC/$m" "$TMP/ir/$MODBASE/$KVER/$m"
    ADDED=$((ADDED+1))
  fi
done
echo "yaya: $ADDED módulos añadidos"
[ "$ADDED" -gt 0 ] || { echo "yaya: ERROR no se añadió ningún módulo"; exit 1; }

# depmod necesita <base>/lib/modules
MADE_LINK=0
if [ "$MODBASE" = "usr/lib/modules" ] && [ ! -e "$TMP/ir/lib/modules" ]; then
  if [ ! -e "$TMP/ir/lib" ]; then ln -s usr/lib "$TMP/ir/lib"; MADE_LINK=1; fi
fi
depmod -b "$TMP/ir" "$KVER"
[ "$MADE_LINK" = 1 ] && rm "$TMP/ir/lib"
grep -q 'i2c-i801' "$TMP/ir/$MODBASE/$KVER/modules.dep" || { echo "yaya: ERROR depmod no registró i2c-i801"; exit 1; }

# reempaquetar
( cd "$TMP/ir" && find . | LC_ALL=C sort | cpio -o -H newc -R 0:0 --quiet | gzip -9 ) > "$TMP/initrd.new"
OLD=$(wc -c < "$IRABS"); NEW=$(wc -c < "$TMP/initrd.new")
mv "$TMP/initrd.new" "$IRABS"
echo "yaya: initrd gtk reempaquetado ($OLD -> $NEW bytes)"
